%style{ nonce: request.content_security_policy_nonce }
  :plain
    .logo-resources__loader {
      position: fixed;
      top: 50%;
      left: 50%;
      width: min(120px, 24vw);
      height: min(120px, 24vw);
      color: #6364ff;
      pointer-events: none;
      transform: translate(-50%, -50%);
      animation: logo-loading-pulse 1.1s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
    }

    @keyframes logo-loading-pulse {
      0%, 100% { transform: translate(-50%, -50%) rotate(-12deg) scale(0.8); }
      25% { transform: translate(-50%, calc(-50% - 24px)) rotate(16deg) scale(1.6); }
      45% { transform: translate(-50%, -50%) rotate(-10deg) scale(0.95); }
      65% { transform: translate(-50%, calc(-50% - 12px)) rotate(10deg) scale(1.35); }
      80% { transform: translate(-50%, -50%) rotate(-6deg) scale(0.9); }
    }

    @media (prefers-reduced-motion: reduce) {
      .logo-resources__loader { animation: none; }
    }
