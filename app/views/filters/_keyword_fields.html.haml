%tr.nested-fields
  %td= f.input :keyword, as: :string
  %td
    .label_input__wrapper= f.input_field :whole_word
  %td
    = f.hidden_field :id if f.object&.persisted? # Required so Rails doesn't put the field outside of the <tr/>

    - if f.object&.persisted?
      = f.hidden_field :_destroy, value: '0', class: 'destroy-flag'

    %button.table-action-link{ type: 'button', data: { action: 'remove-association' } }
      = safe_join([material_symbol('close'), t('filters.index.delete')])
