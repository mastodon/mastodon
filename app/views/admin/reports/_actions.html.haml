= form_with url: preview_admin_report_actions_path(report) do |form|
  .report-actions
    .report-actions__item
      .report-actions__item__button
        = link_to t('admin.reports.mark_as_resolved'), resolve_admin_report_path(report), method: :post, class: 'button'
      .report-actions__item__description
        = t('admin.reports.actions.resolve_description_html')
    - if report.collections.any? || statuses.any? { |status| (status.with_media? || status.with_preview_card?) && !status.discarded? }
      .report-actions__item
        .report-actions__item__button
          = form.button t('admin.reports.mark_as_sensitive'),
                        name: :mark_as_sensitive,
                        class: 'button'
        .report-actions__item__description
          = t('admin.reports.actions.mark_as_sensitive_description_html')
    .report-actions__item
      .report-actions__item__button
        = form.button t('admin.reports.delete_and_resolve'),
                      name: :delete,
                      class: 'button button--destructive',
                      disabled: (report.collections + statuses).empty?,
                      title: (report.collections + statuses).empty? ? t('admin.reports.actions_no_posts') : ''
      .report-actions__item__description
        = t('admin.reports.actions.delete_description_html')
    - if report.target_account.local? && report.target_account.user_approved?
      .report-actions__item
        .report-actions__item__button
          = link_to t('admin.accounts.warn'), new_admin_account_action_path(report.target_account_id, report_id: report.id, type: 'none'), class: 'button' if can?(:warn, report.target_account)
        .report-actions__item__description
          = t('admin.reports.actions.warn_description_html')
      - if report.target_account.user_disabled?
        .report-actions__item
          .report-actions__item__button
            - if can?(:enable, report.target_account.user)
              = link_to(report.target_account.user_confirmed? ? t('admin.accounts.enable') : t('admin.accounts.enable_unconfirmed'), enable_admin_account_path(report.target_account_id),
                        method: :post, class: 'button')
          .report-actions__item__description
            = t('admin.reports.actions.disable_description_html')
      - elsif can?(:disable, report.target_account.user)
        .report-actions__item
          .report-actions__item__button
            = link_to t('admin.accounts.disable'), new_admin_account_action_path(report.target_account_id, report_id: report.id, type: 'disable'), class: 'button'
          .report-actions__item__description
            = t('admin.reports.actions.disable_description_html')
    - if report.target_account.sensitized?
      .report-actions__item
        .report-actions__item__button
          = link_to t('admin.accounts.undo_sensitized'), unsensitive_admin_account_path(report.target_account_id), method: :post, class: 'button' if can?(:unsensitive, report.target_account)
        .report-actions__item__description
          = t('admin.reports.actions.force_sensitive_descption_html')
    - elsif !report.target_account.local? || report.target_account.user_approved?
      .report-actions__item
        .report-actions__item__button
          = link_to t('admin.accounts.sensitive'), new_admin_account_action_path(report.target_account_id, report_id: report.id, type: 'sensitive'), class: 'button' if can?(:sensitive, report.target_account)
        .report-actions__item__description
          = t('admin.reports.actions.force_sensitive_descption_html')
    - if report.target_account.silenced?
      .report-actions__item
        .report-actions__item__button
          = link_to t('admin.accounts.undo_silenced'), unsilence_admin_account_path(report.target_account_id), method: :post, class: 'button' if can?(:unsilence, report.target_account)
        .report-actions__item__description
          = t('admin.reports.actions.silence_description_html')
    - elsif !report.target_account.local? || report.target_account.user_approved?
      .report-actions__item
        .report-actions__item__button
          = link_to t('admin.accounts.silence'), new_admin_account_action_path(report.target_account_id, report_id: report.id, type: 'silence'), class: 'button' if can?(:silence, report.target_account)
        .report-actions__item__description
          = t('admin.reports.actions.silence_description_html')
    - if (!report.target_account.local? || report.target_account.user_approved?) && can?(:suspend, report.target_account)
      .report-actions__item
        .report-actions__item__button
          - if !report.target_account.suspended_locally?
            = link_to t('admin.accounts.perform_full_suspension'), new_admin_account_action_path(report.target_account_id, report_id: report.id, type: 'suspend'),
                      class: 'button button--destructive',
                      disabled: report.target_account.suspended_locally?
          - elsif report.target_account.suspended_locally?
            = form.button t('admin.accounts.suspend'),
                          name: :suspend,
                          class: 'button button--destructive',
                          disabled: report.target_account.suspended_locally?
        .report-actions__item__description
          = t('admin.reports.actions.suspend_description_html')
