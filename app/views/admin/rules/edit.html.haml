- content_for :page_title do
  = t('admin.rules.edit')

= simple_form_for [:admin, @rule] do |form|
  = render 'shared/error_messages', object: @rule

  = render form

  %hr.spacer/

  %h2= t('admin.rules.translations')

  %p.hint= t('admin.rules.translations_explanation')

  .table-wrapper
    %table.table.keywords-table
      %thead
        %tr
          %th= t('admin.rules.translation')
          %th
      %tbody
        = form.simple_fields_for :translations do |translation|
          = render 'translation_fields', f: translation
      %tfoot
        %tr
          %td{ colspan: 3 }
            %button.table-action-link{ type: :button, data: { action: 'add-association', template_id: 'translation-fields-template', placeholder: 'new_translations', container: '.keywords-table tbody' } }
              = safe_join([material_symbol('add'), t('admin.rules.add_translation')])

  %template#translation-fields-template
    = form.simple_fields_for :translations, form.object.translations.build, child_index: 'new_translations' do |translation|
      = render 'translation_fields', f: translation

  .actions
    = form.button :button, t('generic.save_changes'), type: :submit
