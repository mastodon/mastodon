- content_for(:heading) do
  .content__heading__row
    %h1= t('admin.moderation_suggestions.title')

  = render 'admin/moderation_subscriptions/shared/links'

%hr.spacer/

- if @moderation_suggestions.empty?
  .muted-hint.center-text
    = t 'admin.moderation_suggestions.empty'
- else
  = render partial: 'moderation_suggestion', collection: @moderation_suggestions
