- content_for :page_title do
  = t('admin.settings.external.title')

- content_for :heading do
  %h1= t('admin.settings.title')
  = render partial: 'admin/settings/shared/links'

= simple_form_for @admin_settings, url: admin_settings_external_path do |f|
  = render 'shared/error_messages', object: @admin_settings

  %p.lead= t('admin.settings.external.preamble')

  %h2= t('admin.settings.external.privacy')

  .fields-group
    = f.input :noindex,
              as: :boolean,
              hint: t('admin.settings.default_noindex.desc_html'),
              label: t('admin.settings.default_noindex.title'),
              wrapper: :with_label

  .fields-group
    = f.input :allow_referrer_origin,
              as: :boolean,
              hint: t('admin.settings.allow_referrer_origin.desc'),
              label: t('admin.settings.allow_referrer_origin.title'),
              wrapper: :with_label

  %h2= t('admin.settings.external.publish_statistics')

  .fields-group
    = f.input :activity_api_enabled,
              as: :boolean,
              wrapper: :with_label,
              recommended: :recommended

  .fields-group
    = f.input :peers_api_enabled,
              as: :boolean,
              wrapper: :with_label,
              recommended: :recommended

  %h2= t('admin.settings.security.federation_authentication')

  .fields-group
    = f.input :authorized_fetch,
              as: :radio_buttons,
              collection: f.object.class::AUTHORIZED_FETCH_MODES,
              disabled: authorized_fetch_overridden?,
              hint: authorized_fetch_hint_text,
              label: t('admin.settings.security.authorized_fetch'),
              include_blank: false,
              label_method: ->(mode) { safe_join([I18n.t(mode, scope: 'admin.settings.security.authorized_fetch_modes'), content_tag(:span, I18n.t(mode, scope: 'admin.settings.security.authorized_fetch_hints'), class: 'hint')]) },
              recommended: authorized_fetch_recommended_value,
              warning_hint: authorized_fetch_warning_hint_text,
              wrapper: :with_block_label

  .actions
    = f.button :button, t('generic.save_changes'), type: :submit
