- content_for :heading do
  .heading-with-lead
    %h1= t('admin.server_checks.title')
    %p.lead= t('admin.server_checks.lead')

%h2.heading-medium= t('admin.server_checks.recommendations.title')

- %w(critical warning suggestion error unprocessed completed ignored).each do |category|
  - if @checks[category]&.any?
    = render 'admin/server_checks/category', category: category, checks: @checks[category]
