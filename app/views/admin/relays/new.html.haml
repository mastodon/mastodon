- content_for :page_title do
  = t('admin.relays.add_new')

= simple_form_for [:admin, @relay] do |f|
  = render 'shared/error_messages', object: @relay

  .fields-group
    = f.input :acct, as: :string, wrapper: :with_block_label

  .fields-group
    = f.input :direction, collection: Relay.directions.keys, as: :radio_buttons, wrapper: :with_block_label, label_method: ->(dir) { relays_direction_label(dir) }

  .fields-group
    = f.input :requires_opt_in, wrapper: :with_label

  .actions
    = f.button :button, t('admin.relays.save_and_enable'), type: :submit
