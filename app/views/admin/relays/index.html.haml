- content_for :page_title do
  = t('admin.relays.title')

.simple_form
  %p.hint= t('admin.relays.description_html')
  = link_to @relays.empty? ? t('admin.relays.setup') : t('admin.relays.add_new'), new_admin_relay_path, class: 'button button--block'

- unless @relays.empty?
  %hr.spacer

  .applications-list
    = render @relays
