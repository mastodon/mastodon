= simple_form_for @account_action, url: admin_account_action_path(@account.id) do |f|
  - @report_id = params[:report_id] if params[:report_id].present?
  - @type = params[:type]

  - content_for :page_title do
    = t('admin.account_actions.title', acct: @account.pretty_acct)

  - content_for :heading_actions do
    .fields-group
      = f.input :type,
                as: :select,
                collection: Admin::AccountAction::TYPES,
                include_blank: false,
                label_method: ->(type) { I18n.t("admin.warning_presets.dropdown.#{type}") },
                required: false,
                input_html: { class: 'account_action_type' }

  - if @account.suspended_locally?
    .flash-message.alert
      = t('admin.account_actions.already_suspended')
  - elsif @account.silenced?
    .flash-message.warn
      = t('admin.account_actions.already_silenced')

  %div{ 'id' => 'data-action-text-box' }
    = render partial: 'actions_text_box', locals: { account: @account, report_id: @report_id }

  %hr.spacer/
  %h3= t('admin.account_actions.notification_title')

  - if @account.local?
    .fields-group
      = f.input :send_email_notification,
                as: :boolean,
                wrapper: :with_label

    %hr.spacer/

    - unless @warning_presets.empty?
      .fields-group
        = f.input :warning_preset_id,
                  collection: label_and_categories_collection(@warning_presets),
                  wrapper: :with_block_label,
                  hint: t('simple_form.hints.admin_account_action.warning_preset_html', path: admin_warning_presets_path),
                  input_html: { id: 'presets_dropdown' }

    .fields-group
      = f.input :text,
                as: :text,
                hint: t('simple_form.hints.admin_account_action.text'),
                wrapper: :with_block_label

    - if @account.local? && params[:report_id].present?
      %hr.spacer/

      .fields-group
        = f.input :include_statuses,
                  as: :boolean,
                  wrapper: :with_label

      %hr.spacer/

  .actions
    = f.button :button,
               t('admin.account_actions.action'),
               type: :submit
